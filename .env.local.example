# =============================================================================
# 本地开发环境密钥模板 (Secrets Template)
# =============================================================================
# 复制本文件为 .env.local 并填入实际值，.env.local 已被 gitignore 保护。
# 当前模板项目本身用不到这些密钥，但作为新项目起点时，按需启用即可。
#
# 生产环境密钥建议通过 CI/CD 的 secrets/vars 注入，不要写死在代码或
# 提交到仓库中。
# =============================================================================

# -----------------------------------------------------------------------------
# Auth.js / NextAuth v5
# -----------------------------------------------------------------------------
# 用于加密 session token、JWT 等。可通过以下命令生成：
#   npx auth secret
# AUTH_SECRET=

# -----------------------------------------------------------------------------
# OAuth Provider Keys
# -----------------------------------------------------------------------------
# 如需接入第三方登录，填入对应 provider 的 client id / secret
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# OIDC / SSO 通用配置
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=
# AUTH_OIDC_ISSUER=

# -----------------------------------------------------------------------------
# 数据库 (示例: SQLite / PostgreSQL / MySQL)
# -----------------------------------------------------------------------------
# SQLite (文件模式)
# DATABASE_URL=file:./data/sqlite.db
#
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
#
# MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# -----------------------------------------------------------------------------
# API Keys (外部服务)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# 分析与监控
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# 其他
# -----------------------------------------------------------------------------
# 应用级加密盐值（非 NextAuth 的 AUTH_SECRET）
# APP_SECRET=

# 邮件 SMTP 配置
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
